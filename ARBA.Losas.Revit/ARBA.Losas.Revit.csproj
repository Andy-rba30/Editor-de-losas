<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Revit 2027 corre sobre .NET 10. Para 2025/2026 seria net8.0-windows. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <!-- Permite compilar el proyecto -windows en Linux/CI sin instalar Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ARBA.Losas.Revit</AssemblyName>
    <RootNamespace>ARBA.Losas.Revit</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Las librerias .NET no copian sus paquetes al output por defecto: hace falta para Clipper2Lib.dll -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Copia a la carpeta de add-ins de Revit al compilar: por defecto solo en Debug y en Windows -->
    <DeployToRevit Condition="'$(DeployToRevit)'=='' AND '$(Configuration)'=='Debug' AND '$(OS)'=='Windows_NT'">true</DeployToRevit>
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo ensamblados de referencia: Revit ya carga los suyos. ExcludeAssets=runtime evita copiarlos al output. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Geometria pura (y Clipper2Lib.dll, que si se despliega junto a esta DLL) -->
    <ProjectReference Include="..\ARBA.Losas.Geometry\ARBA.Losas.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ARBA.Losas.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Despliegue para desarrollo: %AppData%\Autodesk\Revit\Addins\2027\ARBA.Losas\ (por usuario).
    Se activa con -p:DeployToRevit=true (o automaticamente en Debug en Windows) y se
    desactiva con -p:DeployToRevit=false para no molestar en CI.
  -->
  <Target Name="CopyToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)'=='true'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
      <AddinDir>$(RevitAddinsDir)ARBA.Losas\</AddinDir>
    </PropertyGroup>
    <MakeDir Directories="$(AddinDir)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)ARBA.Losas.Geometry.dll;$(TargetDir)Clipper2Lib.dll" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(AddinDir)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(ProjectDir)ARBA.Losas.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Message Importance="high" Text="ARBA.Losas desplegado en $(AddinDir)" />
  </Target>

</Project>
